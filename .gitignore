# Python environment and cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# IDE and OS files
.idea/
.DS_Store

# Pipeline runtime directories and generated state files (ignored at any depth)
inputs/
tmp/
tmp_*/
*_state.json

# Ignore all runtime output directories everywhere
outputs/

# Ignore generated plot files everywhere, except reference plots
*.png
!**/reference_outputs/*.png

# Quantum ESPRESSO specific temporary/large files
*.save/
*.wfc*
*.mix*
*.xml
*.igk*
*.rho
